<?xml version="1.0" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MakerTally.App.Controls" xmlns:vm="clr-namespace:MakerTally.App.Presentation.ViewModels" x:Class="MakerTally.App.Views.InventoryView" x:DataType="vm:MainViewModel">
  <Grid Padding="{StaticResource CompactPagePadding}" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Gap}">
    <Label Text="{local:LocalizedText Inventory}" Style="{StaticResource CompactPageTitle}"/>
    <CollectionView Grid.Row="1" x:Name="FilamentCards" ItemsSource="{Binding InventoryCards}" SelectionMode="None" AutomationId="FilamentCards">
      <CollectionView.ItemsLayout><GridItemsLayout Span="1" Orientation="Vertical" HorizontalItemSpacing="10" VerticalItemSpacing="8"/></CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="vm:FilamentCardViewModel">
          <Border Style="{StaticResource CompactFilamentCard}">
            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsInactive}" Value="True"><Setter Property="Opacity" Value="0.75"/></DataTrigger></Border.Triggers>
            <VerticalStackLayout Spacing="6">
              <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
                <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                  <Label Text="{Binding Name}" Style="{StaticResource Section}" LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding Name}"/>
                  <Label Style="{StaticResource Helper}"><Label.FormattedText><FormattedString><Span Text="{Binding Weight}"/><Span Text="{local:LocalizedText SpecificationSeparator}"/><Span Text="{Binding Power}"/></FormattedString></Label.FormattedText></Label>
                  <Label Text="{Binding Status}" IsVisible="{Binding IsInactive}" Style="{StaticResource Helper}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{local:LocalizedText ActionsGlyph}" Style="{StaticResource FilamentActionButton}" SemanticProperties.Description="{local:LocalizedText FilamentActions}" ToolTipProperties.Text="{local:LocalizedText FilamentActions}" Clicked="FilamentActions"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="{Binding PurchasePrice}" Style="{StaticResource Helper}"/><Label Grid.Column="1" Text="{Binding PricePerKg}" FontFamily="{StaticResource StrongFont}"/></Grid>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <!-- A dedicated bottom row keeps the floating action clear of cards and navigation. -->
    <Button Grid.Row="2" Text="{local:LocalizedText AddFloating}" Command="{Binding AddCommand}" Style="{StaticResource FilamentFab}" HorizontalOptions="End" Margin="0,0,4,4" SemanticProperties.Description="{local:LocalizedText AddFilament}" ToolTipProperties.Text="{local:LocalizedText AddFilament}" AutomationId="AddFilament"/>
  </Grid>
</ContentView>
