<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MakerTally.Tests</RootNamespace>
    <AssemblyName>MakerTally.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MakerTally.Core\MakerTally.Core.csproj" />
    <!-- Exercise the actual platform-independent presentation source without a MAUI host. -->
    <Compile Include="../../src/MakerTally.App/Presentation/**/*.cs" Link="Presentation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/MakerTally.App/Platforms/Windows/WindowPlacement.cs" Link="Windows/WindowPlacement.cs" />
    <EmbeddedResource Include="../../src/MakerTally.App/Resources/Localization/*.json" LogicalName="MakerTally.Strings.%(Filename).json" />
  </ItemGroup>

</Project>
