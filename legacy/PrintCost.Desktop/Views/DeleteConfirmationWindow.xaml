<Window x:Class="PrintCost.Desktop.Views.DeleteConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}"
 Title="{DynamicResource DeleteFilament}" Width="460" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="24">
  <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" Margin="0,0,0,24" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{DynamicResource Cancel}" IsCancel="True" IsDefault="True" MinWidth="90" />
   <Button x:Name="ConfirmButton" Content="{DynamicResource Delete}" Click="ConfirmClick" Margin="12,0,0,0" MinWidth="90" />
  </StackPanel>
 </StackPanel>
</Window>
