<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PrintCost.Desktop.Views.FilamentEditorWindow" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="560" Height="690" MinWidth="460" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Title}"/>
        <TextBlock Text="{DynamicResource EditorHint}" Style="{StaticResource Subtitle}"/>
        <TextBlock Text="{DynamicResource Name}" Style="{StaticResource Label}"/>
        <TextBox x:Name="NameInput" AutomationProperties.Name="{DynamicResource Name}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <Border Height="14"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Brand}" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Brand}" AutomationProperties.Name="{DynamicResource Brand}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{DynamicResource MaterialType}" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding MaterialType}" AutomationProperties.Name="{DynamicResource MaterialType}"/>
          </StackPanel>
        </Grid>
        <Border Height="14"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource SpoolWeight}" Style="{StaticResource Label}"/>
            <TextBox x:Name="SpoolWeightInput" AutomationProperties.Name="{DynamicResource SpoolWeight}" Text="{Binding Weight.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{DynamicResource PurchasePrice}" Style="{StaticResource Label}"/>
            <TextBox x:Name="PriceInput" AutomationProperties.Name="{DynamicResource PurchasePrice}" Text="{Binding Price.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
          </StackPanel>
        </Grid>
        <Border Height="14"/>
        <Grid Margin="0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource PriceKg}" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Grid.Column="1" Text="{Binding PricePerKg}" Margin="12,0,0,0" FontWeight="SemiBold"/>
        </Grid>
        <Border Height="14"/>
        <TextBlock Text="{DynamicResource PrintPower}" Style="{StaticResource Label}"/>
        <TextBox x:Name="PowerInput" AutomationProperties.Name="{DynamicResource PrintPower}" Text="{Binding Power.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
        <CheckBox Content="{DynamicResource Active}" IsChecked="{Binding IsActive}" Margin="0,18,0,14"/>
        <TextBlock Text="{DynamicResource Notes}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Notes}" AutomationProperties.Name="{DynamicResource Notes}" AcceptsReturn="True" Height="74" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="90"/>
      <Button x:Name="SaveButton" Content="{DynamicResource Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="10,0,0,0" MinWidth="90"/>
    </StackPanel>
  </Grid>
</Window>
