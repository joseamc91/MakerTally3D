<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PrintCost.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="{DynamicResource AppName}" Width="1100" Height="760" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="192"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#EDF0F4" BorderBrush="#DDE2E8" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24">
        <StackPanel DockPanel.Dock="Top" Margin="12,0,0,32">
          <TextBlock Text="{DynamicResource AppName}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0">
          <TextBlock Text="{DynamicResource Version}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </StackPanel>
        <StackPanel>
          <RadioButton x:Name="CalculatorNav" Style="{StaticResource Navigation}" GroupName="Navigation" Content="{DynamicResource Calculator}" IsChecked="{Binding IsCalculator, Mode=OneWay}" Command="{Binding CalculatorCommand}"/>
          <RadioButton x:Name="InventoryNav" Style="{StaticResource Navigation}" GroupName="Navigation" Content="{DynamicResource Inventory}" IsChecked="{Binding IsInventory, Mode=OneWay}" Command="{Binding InventoryCommand}"/>
          <RadioButton x:Name="SettingsNav" Style="{StaticResource Navigation}" GroupName="Navigation" Content="{DynamicResource Settings}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding SettingsCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="#FFF3E9" Padding="16" Margin="28,18,28,0" CornerRadius="8" Visibility="{Binding HasStorageMessage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding StorageMessage}" TextWrapping="Wrap"/>
      </Border>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="CalculatorPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding IsCalculator, Converter={StaticResource BoolVisibility}}">
          <StackPanel Margin="28,24" MinWidth="680">
            <TextBlock Text="{DynamicResource Calculator}" Style="{StaticResource Title}"/>
            <TextBlock Text="{DynamicResource CalculatorSubtitle}" Style="{StaticResource Subtitle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Material}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{DynamicResource Filament}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="FilamentSelector" AutomationProperties.Name="{DynamicResource Filament}" ItemsSource="{Binding ActiveFilaments}" SelectedItem="{Binding SelectedFilament}" DisplayMemberPath="Name"/>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource MaterialType}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding MaterialType}" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource PriceKg}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding MaterialPrice}" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource PrintPower}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding MaterialPower}" Margin="12,0,0,0"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Printing}" Style="{StaticResource Section}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource PieceWeight}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="WeightInput" AutomationProperties.Name="{DynamicResource PieceWeight}" Text="{Binding Weight.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource PrintTime}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="HoursInput" AutomationProperties.Name="{DynamicResource PrintTime}" Text="{Binding Hours.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Sale}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{DynamicResource SaleMultiplier}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="MultiplierInput" AutomationProperties.Name="{DynamicResource SaleMultiplier}" Text="{Binding Multiplier.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{DynamicResource SimulationHint}" Style="{StaticResource Subtitle}" Margin="0,8,0,0" FontSize="12"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Electricity}" Style="{StaticResource Section}"/>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource ElectricityPrice}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding ElectricitySummary}" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource HeatingPower}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding HeatingPowerSummary}" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource HeatingTime}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding HeatingTimeSummary}" Margin="12,0,0,0"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource MachineCost}" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding MachineSummary}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Border Background="#FFF3E9" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCalculation}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding CalculationMessage}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Visibility="{Binding HasCalculation, Converter={StaticResource BoolVisibility}}">
                  <Border Background="#E4ECF9" BorderBrush="#CFDCF0" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource SalePrice}" Style="{StaticResource Section}"/>
                      <TextBlock x:Name="SuggestedPriceText" Text="{Binding SalePrice}" Foreground="{StaticResource AccentBrush}" FontSize="40" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Breakdown}" Style="{StaticResource Section}"/>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource MaterialCost}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MaterialCost}" Margin="12,0,0,0"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource ElectricityCost}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElectricityCost}" Margin="12,0,0,0"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource PrintCost}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PrintCost}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource MachineCost}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MachineCost}" Margin="12,0,0,0"/>
                      </Grid>
                      <Separator Margin="0,10"/>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource FullCost}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FullCost}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource GrossProfit}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Profit}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Margin}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Margin}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource TechnicalDetails}" Style="{StaticResource Section}"/>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource PriceGram}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PricePerGram}" Margin="12,0,0,0"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource HeatingEnergy}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding HeatingEnergy}" Margin="12,0,0,0"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource PrintingEnergy}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PrintingEnergy}" Margin="12,0,0,0"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource TotalEnergy}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalEnergy}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                      </Grid>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource PreciseElectricity}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PreciseElectricity}" Margin="12,0,0,0"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="InventoryPage" Margin="28,24" Visibility="{Binding IsInventory, Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Inventory}" Style="{StaticResource Title}"/>
            <TextBlock Text="{DynamicResource InventorySubtitle}" Style="{StaticResource Subtitle}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="{DynamicResource AddFilament}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="{DynamicResource Edit}" Command="{Binding EditCommand}" Margin="10,0,0,0"/>
            <Button Content="{DynamicResource Delete}" Command="{Binding DeleteCommand}" Margin="10,0,0,0"/>
          </StackPanel>
          <DataGrid Grid.Row="2" x:Name="InventoryGrid" ItemsSource="{Binding Filaments}" SelectedItem="{Binding InventorySelection}" AutomationProperties.Name="{DynamicResource Inventory}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="190" SortMemberPath="Name">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Name}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <Binding Path="Name"/>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="85" SortMemberPath="MaterialType">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource MaterialType}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <Binding Path="MaterialType"/>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="100" SortMemberPath="Brand">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Brand}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <Binding Path="Brand"/>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="100" SortMemberPath="SpoolWeightGrams">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource WeightColumn}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Display}" ConverterParameter="Weight">
                          <Binding Path="SpoolWeightGrams"/>
                          <Binding Path="DataContext.SelectedLanguage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="120" SortMemberPath="PurchasePrice">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource PurchaseColumn}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Display}" ConverterParameter="Money">
                          <Binding Path="PurchasePrice"/>
                          <Binding Path="DataContext.SelectedLanguage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="110" SortMemberPath="PricePerKg">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource PriceKg}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Display}" ConverterParameter="Kg">
                          <Binding Path="PricePerKg"/>
                          <Binding Path="DataContext.SelectedLanguage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="100" SortMemberPath="PrintPowerWatts">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource PowerColumn}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Display}" ConverterParameter="Power">
                          <Binding Path="PrintPowerWatts"/>
                          <Binding Path="DataContext.SelectedLanguage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="75">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Active}"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}">
          <StackPanel Margin="28,24" MinWidth="630" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Title}"/>
            <TextBlock Text="{DynamicResource SettingsSubtitle}" Style="{StaticResource Subtitle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Language}" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="LanguageSelector" SelectedValue="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Language}">
                      <ComboBoxItem Tag="es-ES" Content="{DynamicResource Spanish}"/>
                      <ComboBoxItem Tag="en-US" Content="{DynamicResource English}"/>
                    </ComboBox>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Electricity}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{DynamicResource ElectricityPrice}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ElectricityPriceInput" AutomationProperties.Name="{DynamicResource ElectricityPrice}" Text="{Binding ElectricityPrice.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    <Border Height="14"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource HeatingPower}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="HeatingPowerInput" AutomationProperties.Name="{DynamicResource HeatingPower}" Text="{Binding HeatingPower.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource HeatingTime}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="HeatingMinutesInput" AutomationProperties.Name="{DynamicResource HeatingTime}" Text="{Binding HeatingMinutes.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Machine}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{DynamicResource MachineRate}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="MachineRateInput" AutomationProperties.Name="{DynamicResource MachineRate}" Text="{Binding MachineRate.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Sale}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{DynamicResource DefaultMultiplier}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DefaultMultiplierInput" AutomationProperties.Name="{DynamicResource DefaultMultiplier}" Text="{Binding DefaultMultiplier.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{DynamicResource DefaultHint}" Style="{StaticResource Subtitle}" Margin="0,10,0,0" FontSize="12"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Application}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{DynamicResource Version}" Style="{StaticResource Label}"/>
                    <TextBlock Text="{DynamicResource OfflineHint}" Style="{StaticResource Subtitle}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SettingsStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
